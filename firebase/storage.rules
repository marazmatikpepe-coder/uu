rules_version = '2';

// Сейчас проект использует imgbb для изображений (см. lib/imgbb/upload.ts),
// поэтому Firebase Storage активно не используется. Эти правила — на случай,
// если позже подключишь Storage для не-графических файлов или аудио.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
